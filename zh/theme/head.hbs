{{!--
  Custom SEO / social sharing meta tags injected into every mdBook page.
  Chinese site version.

  NOTE: Canonical, hreflang, and per-page description are injected by
  scripts/fix-seo.sh post-build. Placeholders below are replaced with
  correct per-page values.
--}}

<!-- Open Graph -->
<meta property="og:title" content="{{ chapter_title }} — {{ book_title }}">
<!-- SEO:OG_DESCRIPTION -->
<meta property="og:type" content="article">
<meta property="og:site_name" content="{{ book_title }}">
<meta property="og:locale" content="zh_CN">
<meta property="og:image" content="https://diaozxin007.github.io/reading-claude-code/og-cover.png">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ chapter_title }} — {{ book_title }}">
<!-- SEO:TWITTER_DESCRIPTION -->
<meta name="twitter:image" content="https://diaozxin007.github.io/reading-claude-code/og-cover.png">

<!-- SEO keywords · 中文技术圈常用查询词 -->
<meta name="keywords" content="Claude Code, Claude Code Tools, AI Agent 工具设计, Anthropic, LLM tool call, AskUserQuestion, Agent 架构, prompt engineering, jooj, AI 协作方法论, mdBook">

<!-- Robots · 允许所有搜索引擎索引 -->
<meta name="robots" content="index, follow">

<!-- SEO:HREFLANG -->

<!-- SEO:CANONICAL -->

<!-- 作者 & 版权信息 -->
<meta name="author" content="diaozxin007">
<meta name="publisher" content="Reading Claude Code">

<!-- 搜索引擎站长验证 -->
<meta name="google-site-verification" content="49tbrMMyQkdeYqQxZcQlUMG47fjCqq0kbrqEIdJ5jRw">
<!-- Bing 从 Google Search Console 一键导入 · 不需要单独验证 -->
